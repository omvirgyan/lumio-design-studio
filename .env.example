# Copy to .env and replace the URL with your own PostgreSQL connection string.
# The setup script below is only for a local PostgreSQL server.

# PostgreSQL connection used by the app.
DATABASE_URL=postgresql://lumio:change-me@localhost:5432/lumio

# Optional: separate database for data-layer tests (skipped when unset).
# Never point this at a database containing real app data.
# TEST_DATABASE_URL=postgresql://lumio:change-me@localhost:5432/lumio_test

# Optional: max connections in the pool (default 10).
# DATABASE_POOL_MAX=10

# Optional Google sign-in. Create a Google OAuth Web application with the
# authorized redirect URI http://localhost:3000/api/auth/login.
# Use your deployed HTTPS origin and matching redirect URI in production.
# APP_ORIGIN=http://localhost:3000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional account email. Without this, email signups work as before but email
# verification and password reset are unavailable. Use an SMTP provider and
# set APP_ORIGIN above to this site's exact public origin.
# SMTP_URL=smtps://username:password@smtp.example.com:465
# SMTP_FROM=Lumio <no-reply@example.com>

# Optional photo background removal (remove.bg) and AI Studio (OpenAI).
# Keep these keys server-side and out of Git.
# REMOVE_BG_API_KEY=
# OPENAI_API_KEY=
# OPENAI_TEXT_MODEL=gpt-4o-mini
# OPENAI_IMAGE_MODEL=gpt-image-1-mini
